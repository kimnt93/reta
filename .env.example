# Local secrets only. Copy to .env, chmod 600 .env, never commit it.
# Exported environment overrides .env. Configure only the selected provider.
# Any provider ID uses RETA_<UPPERCASE_ID>_USERNAME and _PASSWORD.
# _FILE alternatives read an existing local secret file instead.
RETA_CHOBOT_USERNAME=
RETA_CHOBOT_PASSWORD=
RETA_CHOBOT_USERNAME_FILE=
RETA_CHOBOT_PASSWORD_FILE=

# For installed skill reference scripts; not needed from the project root.
RETA_PROJECT_ROOT=

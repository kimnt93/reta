# Local secrets only. Copy to .env, chmod 600 .env, never commit it.
# Exported environment overrides .env. Leave unused values blank.
# Any provider ID uses RETA_<UPPERCASE_ID>_USERNAME and _PASSWORD.
# _FILE alternatives read an existing local secret file instead.
# Provider credentials take precedence as a PAIR. Partial pairs fail.
# Defaults apply only when no selected-provider credential is configured.
# They are used only for reviewed isolated login, never automatic discovery.
RETA_DEFAULT_USERNAME=
RETA_DEFAULT_PASSWORD=
RETA_DEFAULT_USERNAME_FILE=
RETA_DEFAULT_PASSWORD_FILE=

# Source inventory: plans/03-source-discovery.md. These are secret slots,
# not installed connectors or accounts. Supply your own existing credentials.
# Use id=ctrader for Copy or Store; id=mql5 for Signals or Market.
RETA_CTRADER_USERNAME=
RETA_CTRADER_PASSWORD=
RETA_CTRADER_USERNAME_FILE=
RETA_CTRADER_PASSWORD_FILE=
RETA_MQL5_USERNAME=
RETA_MQL5_PASSWORD=
RETA_MQL5_USERNAME_FILE=
RETA_MQL5_PASSWORD_FILE=
RETA_COLLECTIVE2_USERNAME=
RETA_COLLECTIVE2_PASSWORD=
RETA_COLLECTIVE2_USERNAME_FILE=
RETA_COLLECTIVE2_PASSWORD_FILE=
